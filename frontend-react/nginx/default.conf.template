# Processado por envsubst no start do contêiner (imagem nginx: /etc/nginx/templates → /etc/nginx/conf.d).
# O DNS dos serviços é resolvido NA REQUISIÇÃO (variável no proxy_pass + resolver), para o nginx subir mesmo que um
# serviço ainda não exista; upstream indisponível responde 502/504 sem derrubar o nginx.

log_format json escape=json '{"time":"$time_iso8601","remote":"$remote_addr","method":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,"ms":"$request_time","upstream":"$upstream_addr"}';
access_log /dev/stdout json;

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
  listen 80;
  root /usr/share/nginx/html;

  # config de runtime gerada no start (URL do Kafbat); nunca em cache
  location = /config.js {
    add_header Cache-Control "no-store";
  }

  # APIs dos serviços de domínio (mesma origem para o navegador: sem CORS); caminho preservado
  location /api/orders {
    set $upstream ${ORDER_API_URL};
    proxy_pass $upstream;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;
  }
  location /api/payments {
    set $upstream ${PAYMENT_API_URL};
    proxy_pass $upstream;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;
  }
  location /api/invoices {
    set $upstream ${INVOICE_API_URL};
    proxy_pass $upstream;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;
  }

  # saúde de cada serviço: /health/<svc> → /actuator/health do serviço
  location = /health/order {
    set $upstream ${ORDER_API_URL};
    rewrite ^ /actuator/health break;
    proxy_pass $upstream;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;
  }
  location = /health/payment {
    set $upstream ${PAYMENT_API_URL};
    rewrite ^ /actuator/health break;
    proxy_pass $upstream;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;
  }
  location = /health/invoice {
    set $upstream ${INVOICE_API_URL};
    rewrite ^ /actuator/health break;
    proxy_pass $upstream;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;
  }

  # SPA: qualquer outra rota cai no index.html
  location / {
    try_files $uri /index.html;
  }
}
